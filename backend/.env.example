HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT=15

# 领域树模型调用
DOMAIN_TREE_RETRY_ATTEMPTS=3
DOMAIN_TREE_RETRY_BASE_DELAY_SECONDS=2
DOMAIN_TREE_JSON_OUTPUT=true
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_OUTPUT_TOKENS_UPPER_BOUND=65536
DOMAIN_TREE_MAX_OUTPUT_TOKENS=16384
DOMAIN_TREE_MAX_HEADING_COUNT=50

# 全文语义分块
SEMANTIC_GRAPH_MAX_WORKERS=4
SEMANTIC_GRAPH_CHUNK_SIZE=6000
SEMANTIC_GRAPH_CHUNK_OVERLAP=400
SEMANTIC_GRAPH_JSON_OUTPUT=true
SEMANTIC_GRAPH_MAX_OUTPUT_TOKENS=4096
SEMANTIC_GRAPH_TYPE_LANGUAGE_MODEL_CORRECTION=false
SEMANTIC_GRAPH_PROGRESS_INTERVAL=10

# 共享熔断器；所有并发分块共用同一窗口
SEMANTIC_GRAPH_FAILURE_WINDOW=20
SEMANTIC_GRAPH_FAILURE_WINDOW_MINIMUM=10
SEMANTIC_GRAPH_FAILURE_RATE_LIMIT=0.5
SEMANTIC_GRAPH_CONSECUTIVE_FATAL_LIMIT=8

# 任务预算；0 表示不设置总量上限
SEMANTIC_GRAPH_MAX_REQUESTS=0
SEMANTIC_GRAPH_MAX_INPUT_TOKENS=0
SEMANTIC_GRAPH_ESTIMATED_CHARS_PER_TOKEN=4

# 图谱发布质量门槛
SEMANTIC_GRAPH_READY_RATIO=0.95
SEMANTIC_GRAPH_DEGRADED_RATIO=0.5
# 可恢复的瞬时故障最多自动断点续跑 2 轮；认证、配额和大面积输出截断会暂停并等待手动继续。
SEMANTIC_GRAPH_AUTO_RESUME_ATTEMPTS=2
SEMANTIC_GRAPH_AUTO_RESUME_DELAY_SECONDS=2

# 后台任务与模型调用计量共用此 SQLite
BACKGROUND_JOB_DB=
BACKGROUND_JOB_MAX_EVENTS_PER_JOB=500
CONVERSATION_DB=

# 外部服务凭据
NCBI_EMAIL=
NCBI_API_KEY=
IEEE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
MINERU_API_TOKEN=
